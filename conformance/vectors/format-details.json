[
  {
    "id": "openai-call-id-is-kept",
    "description": "openai.chat: a different call id does not change the verdict",
    "source": "docs/api-v0.md, decide request",
    "agentTools": {
      "tools": {
        "search_docs": {
          "kind": "read",
          "results": "untrusted",
          "privateData": false
        },
        "get_customer": {
          "kind": "read",
          "results": "trusted",
          "privateData": true
        },
        "list_notes": {
          "kind": "read"
        },
        "send_email": {
          "kind": "send"
        },
        "delete_account": {
          "kind": "destroy"
        },
        "wire_money": {
          "kind": "blocked"
        },
        "run_shell": {
          "as": "Bash",
          "map": {
            "command": "$.cmd"
          }
        },
        "http_get": {
          "as": "WebFetch",
          "map": {
            "url": "$.url"
          }
        },
        "read_file": {
          "as": "Read",
          "map": {
            "file_path": "$.path"
          }
        },
        "write_file": {
          "as": "Write",
          "map": {
            "file_path": "$.path",
            "content": "$.body"
          }
        },
        "nested_shell": {
          "as": "Bash",
          "map": {
            "command": "$.args.cmd"
          }
        },
        "raw_shell": {
          "as": "Bash"
        },
        "raw_fetch": {
          "as": "WebFetch"
        }
      }
    },
    "steps": [
      {
        "kind": "decide",
        "request": {
          "session": "run-1",
          "action": {
            "format": "openai.chat",
            "raw": {
              "id": "call_zzz",
              "type": "function",
              "function": {
                "name": "delete_account",
                "arguments": "{\"id\":\"a-1\"}"
              }
            }
          },
          "context": {
            "attended": true,
            "workspace": [
              "/srv/app"
            ],
            "cwd": "/srv/app"
          }
        },
        "expect": {
          "verdict": "ask",
          "ruleIds": [
            "FW-DESTRUCTIVE"
          ],
          "sessionUntrusted": false,
          "holdsPrivateData": false
        }
      }
    ]
  },
