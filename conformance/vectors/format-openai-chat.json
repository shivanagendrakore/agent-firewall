[
  {
    "id": "openai-read-then-send-asks",
    "description": "A read tool whose results are untrusted, then a send: a person is asked (openai.chat)",
    "source": "docs/api-v0.md, tool registry",
    "agentTools": {
      "tools": {
        "search_docs": {
          "kind": "read",
          "results": "untrusted",
          "privateData": false
        },
        "get_customer": {
          "kind": "read",
          "results": "trusted",
          "privateData": true
        },
        "list_notes": {
          "kind": "read"
        },
        "send_email": {
          "kind": "send"
        },
        "delete_account": {
          "kind": "destroy"
        },
        "wire_money": {
          "kind": "blocked"
        },
        "run_shell": {
          "as": "Bash",
          "map": {
            "command": "$.cmd"
          }
        },
        "http_get": {
          "as": "WebFetch",
          "map": {
            "url": "$.url"
          }
        },
        "read_file": {
          "as": "Read",
          "map": {
            "file_path": "$.path"
          }
        },
        "write_file": {
          "as": "Write",
          "map": {
            "file_path": "$.path",
            "content": "$.body"
          }
        },
        "nested_shell": {
          "as": "Bash",
          "map": {
            "command": "$.args.cmd"
          }
        },
        "raw_shell": {
          "as": "Bash"
        },
        "raw_fetch": {
          "as": "WebFetch"
        }
      }
    },
    "steps": [
      {
        "kind": "decide",
        "request": {
          "session": "run-1",
          "action": {
            "format": "openai.chat",
            "raw": {
              "id": "call_1",
              "type": "function",
              "function": {
                "name": "search_docs",
                "arguments": "{\"q\":\"pricing\"}"
              }
            }
          },
          "context": {
            "attended": true,
            "workspace": [
              "/srv/app"
            ],
            "cwd": "/srv/app"
          }
        },
        "expect": {
          "verdict": "allow",
          "ruleIds": [],
          "sessionUntrusted": true,
          "holdsPrivateData": false
        }
      },
      {
        "kind": "result",
        "request": {
          "session": "run-1",
          "decisionId": "@step:0",
          "output": "(outside content placeholder)"
        },
        "expect": {
          "sessionUntrusted": true,
          "holdsPrivateData": false
        }
      },
      {
        "kind": "decide",
        "request": {
          "session": "run-1",
          "action": {
            "format": "openai.chat",
            "raw": {
              "id": "call_1",
              "type": "function",
              "function": {
                "name": "send_email",
                "arguments": "{\"to\":\"someone@else.example\",\"body\":\"the quarterly numbers\"}"
              }
            }
          },
          "context": {
            "attended": true,
            "workspace": [
              "/srv/app"
            ],
            "cwd": "/srv/app"
          }
        },
        "expect": {
          "verdict": "ask",
          "ruleIds": [
            "FW-MESSAGE"
          ],
          "sessionUntrusted": true,
          "holdsPrivateData": true
        }
      }
    ]
  },
